# Copy to .env and fill in. Never commit .env.
GOOGLE_PLACES_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=sgfoodhunt/0.1 by <your_reddit_username>
# Optional (AI layer via the Claude Code CLI; one of the two)
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=
# Optional (stage 4, social buzz)
SERP_API_KEY=
INSTAGRAM_GRAPH_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
# Optional (stage 5, notifications and export)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# forum topic: t.me/c/<chat>/<topic> -> TELEGRAM_CHAT_ID=-100<chat>, TELEGRAM_THREAD_ID=<topic>
TELEGRAM_THREAD_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
REPORT_EMAIL_TO=
GOOGLE_SHEETS_CREDENTIALS_JSON=
GOOGLE_SHEETS_SPREADSHEET_ID=
